# ----------------------------------------------------------------------------
# AI Governance Dashboard — environment configuration
# Copy to .env and fill in real values. Never commit .env.
# ----------------------------------------------------------------------------

# Postgres async DSN. The hostname must match the docker-compose service name
# (`postgres`) when running through compose, or `localhost` when running the
# backend directly on the host.
DATABASE_URL=postgresql+asyncpg://aigov:aigov@postgres:5432/aigov

# Redis URL — used for cache + APScheduler job store.
REDIS_URL=redis://redis:6379/0

# JWT signing secret. Generate with: openssl rand -hex 32
# Startup refuses to boot if this is left at a known weak value while DEBUG=false.
# Rotating this invalidates every issued access/refresh token.
SECRET_KEY=  # generate with: openssl rand -hex 32

# OpenAI key — only used for the (free) Moderation API in the safety checker.
# If unset, toxicity checks are skipped silently; PII + prompt-injection still run.
OPENAI_API_KEY=sk-...

# Anthropic key — used by the SDK end-to-end test and any Claude-based callers.
ANTHROPIC_API_KEY=sk-ant-...

# Frontend origin allowed by CORS. Update if you host the UI elsewhere.
FRONTEND_URL=http://localhost:3000

# DEBUG=true surfaces exception messages in error responses and prints
# stack traces to stderr. Leave false in production.
DEBUG=false

# Optional: email of the first admin account. Useful for seeding role=admin
# on a fresh database; ordinary registrations default to role=viewer.
FIRST_ADMIN_EMAIL=admin@example.com

# Sentry DSN for error tracking. Leave empty to disable Sentry entirely (local
# dev is unaffected when unset). Get one from https://sentry.io project settings.
# A before_send hook scrubs request bodies on /api/logs so raw prompts/responses
# never reach Sentry.
SENTRY_DSN=

# Deployment environment tag attached to every Sentry event. Common values:
# development, staging, production. Used only when SENTRY_DSN is set.
ENVIRONMENT=development
